// EKUSA Digital Platform - Prisma Schema
// PostgreSQL database schema for institutional data
// Private message plaintext is NEVER stored here

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// Enums
// ============================================

enum AccountStatus {
  registered
  membership_pending
  verified_member
  rejected
  suspended
  deactivated
}

enum MembershipStatus {
  none
  pending
  verified
  rejected
  suspended
}

enum AnnouncementCategory {
  general
  urgent
  meeting
  event
  leadership
  welfare
  election
  administrative
}

enum AnnouncementPriority {
  normal
  important
  urgent
}

enum AnnouncementStatus {
  draft
  scheduled
  published
  archived
}

enum AnnouncementTargetType {
  everyone
  verified_members
  unverified_users
  campus
  committee
  leadership_role
  event_participants
  custom_group
}

enum EventCategory {
  meeting
  hike
  trip
  social
  sports
  academic
  cultural
  welfare
}

enum EventStatus {
  draft
  published
  cancelled
  completed
  archived
}

enum RegistrationStatus {
  registered
  cancelled
  waitlisted
  attended
}

enum WelfareCategory {
  personal
  emergency
  academic
  accommodation
  financial
  general
  other
}

enum WelfareStatus {
  submitted
  under_review
  in_progress
  awaiting_information
  resolved
  closed
}

enum MessageType {
  text
  image
  file
}

enum MessageStatus {
  sent
  delivered
  seen
}

enum CommunityType {
  general
  campus
  constituency
  committee
  interest
  event
}

enum CommunityMemberRole {
  member
  moderator
  admin
}


enum NotificationCategory {
  announcement
  event_reminder
  event_registration
  membership_update
  welfare_update
  message
  group_activity
  admin_alert
}

enum NotificationPriority {
  low
  normal
  high
  critical
}

// ============================================
// Core Account Tables
// ============================================

model User {
  id              String            @id @default(cuid())
  username        String            @unique
  email           String?           @unique
  phoneNumber     String?           @unique
  passwordHash    String
  accountStatus   AccountStatus     @default(registered)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  lastSeenAt      DateTime?
  profile         Profile?
  membership      Membership?
  reviewedMemberships Membership[] @relation("MembershipReviews")
  conversations   ConversationMember[]
  sentMessages    Message[]         @relation("SentMessages")
  welfareRequests WelfareRequest[]  @relation("WelfareRequests")
  assignedWelfare WelfareRequest[]  @relation("AssignedWelfare")
  welfareUpdates  WelfareUpdate[]
  eventRegistrations EventRegistration[]
  createdEvents   Event[]
  communityMemberships CommunityMember[]
  createdCommunities Community[]
  roles           UserRole[]
  assignedRoles   UserRole[]        @relation("AssignedRoles")
  notifications   Notification[]
  auditLogs       AuditLog[]        @relation("AuditLogs")
  blockedUsers    BlockedUser[]     @relation("BlockedBy")
  blockedByUsers  BlockedUser[]     @relation("BlockedUser")
  publishedAnnouncements Announcement[]
  announcementReads AnnouncementRead[]
  leaders         Leader[]
  authSessions    AuthSession[]

  @@index([accountStatus])
  @@map("users")
}

model Profile {
  userId          String    @unique
  displayName     String
  bio             String?
  avatarObjectKey String?
  campus          String?
  course          String?
  yearOfStudy     Int?
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([displayName])
  @@index([campus])
  @@map("profiles")
}

model Membership {
  id                  String            @id @default(cuid())
  userId              String            @unique
  registrationNumber  String            @unique
  campus              String
  course              String
  yearOfStudy         Int
  contactInfo         String?
  membershipStatus    MembershipStatus  @default(pending)
  submittedAt         DateTime          @default(now())
  reviewedAt          DateTime?
  reviewedBy          String?
  rejectionReason     String?

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer            User?             @relation("MembershipReviews", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([membershipStatus])
  @@map("memberships")
}


// ============================================
// Permissions Tables
// ============================================

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  displayName String
  description String?
  permissions String[]     // Array of permission strings
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  userRoles   UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId      String
  roleId      String
  assignedBy  String
  assignedAt  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedByUser User  @relation("AssignedRoles", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================
// Announcement Tables
// ============================================

model Announcement {
  id            String                  @id @default(cuid())
  title         String
  body          String
  category      AnnouncementCategory
  priority      AnnouncementPriority    @default(normal)
  publisherId   String
  status        AnnouncementStatus      @default(draft)
  publishedAt   DateTime?
  scheduledAt   DateTime?
  expiresAt     DateTime?
  pinned        Boolean                 @default(false)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  publisher     User                    @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  targets       AnnouncementTarget[]
  reads         AnnouncementRead[]

  @@index([status, publishedAt])
  @@index([publisherId])
  @@map("announcements")
}

model AnnouncementTarget {
  id              String                   @id @default(cuid())
  announcementId  String
  targetType      AnnouncementTargetType
  targetValue     String

  announcement    Announcement             @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@map("announcement_targets")
}

model AnnouncementRead {
  id              String      @id @default(cuid())
  announcementId  String
  userId          String
  firstOpenedAt   DateTime    @default(now())
  lastOpenedAt    DateTime    @default(now())

  announcement    Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}

// ============================================
// Event Tables
// ============================================

model Event {
  id                    String        @id @default(cuid())
  title                 String
  description           String
  category              EventCategory
  venue                 String
  startAt               DateTime
  endAt                 DateTime
  registrationDeadline  DateTime
  capacity              Int?
  eligibility           String?       // e.g., "verified_members", "campus:embu"
  registrationFee       Int           @default(0) // in cents/KES
  status                EventStatus   @default(draft)
  createdBy             String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  creator               User          @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  registrations         EventRegistration[]

  @@index([status, startAt])
  @@index([category, status])
  @@index([createdBy])
  @@map("events")
}

model EventRegistration {
  id                  String              @id @default(cuid())
  eventId             String
  userId              String
  registrationStatus  RegistrationStatus  @default(registered)
  registeredAt        DateTime            @default(now())
  attendanceStatus    String?             // present, absent, excused

  event               Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId])
  @@index([eventId, registrationStatus])
  @@map("event_registrations")
}

// ============================================
// Welfare Tables
// ============================================

model WelfareRequest {
  id                  String          @id @default(cuid())
  userId              String
  category            WelfareCategory
  subject             String
  description         String
  status              WelfareStatus   @default(submitted)
  assignedOfficerId   String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  closedAt            DateTime?

  user                User            @relation("WelfareRequests", fields: [userId], references: [id], onDelete: Cascade)
  assignedOfficer     User?           @relation("AssignedWelfare", fields: [assignedOfficerId], references: [id], onDelete: SetNull)
  updates             WelfareUpdate[]

  @@index([status, createdAt])
  @@index([userId])
  @@index([assignedOfficerId])
  @@map("welfare_requests")
}

model WelfareUpdate {
  id              String      @id @default(cuid())
  requestId       String
  authorId        String
  message         String
  createdAt       DateTime    @default(now())

  request         WelfareRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author          User         @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([authorId])
  @@map("welfare_updates")
}

// ============================================
// Messaging Tables
// ============================================

model Conversation {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  members         ConversationMember[]
  messages        Message[]

  @@map("conversations")
}

model ConversationMember {
  id              String       @id @default(cuid())
  conversationId  String
  userId          String
  joinedAt        DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id              String        @id @default(cuid())
  conversationId  String
  senderId        String
  content         String
  status          MessageStatus @default(sent)
  sentAt          DateTime      @default(now())
  deliveredAt     DateTime?
  seenAt          DateTime?

  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, sentAt])
  @@map("messages")
}

model BlockedUser {
  id          String   @id @default(cuid())
  blockerId   String
  blockedId   String
  createdAt   DateTime @default(now())

  blocker     User     @relation("BlockedBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked     User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("blocked_users")
}

// ============================================
// Community Tables
// ============================================

model Community {
  id          String         @id @default(cuid())
  name        String
  description String
  type        CommunityType
  avatarObjectKey String?
  isPublic    Boolean        @default(true)
  createdBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  creator     User           @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  members     CommunityMember[]

  @@map("communities")
}

model CommunityMember {
  id          String                @id @default(cuid())
  communityId String
  userId      String
  role        CommunityMemberRole   @default(member)
  joinedAt    DateTime              @default(now())

  community   Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@map("community_members")
}

// ============================================
// Leadership Tables
// ============================================

model LeadershipPosition {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leaders     Leader[]

  @@map("leadership_positions")
}

model Leader {
  id              String   @id @default(cuid())
  userId          String
  positionId      String
  startDate       DateTime
  endDate         DateTime?
  contactInfo     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position        LeadershipPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([userId, positionId])
  @@map("leaders")
}

// ============================================
// Notification Tables
// ============================================

model Notification {
  id          String                 @id @default(cuid())
  userId      String
  category    NotificationCategory
  priority    NotificationPriority   @default(normal)
  title       String
  body        String
  data        Json?
  read        Boolean                @default(false)
  sentAt      DateTime               @default(now())
  readAt      DateTime?

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, sentAt])
  @@map("notifications")
}

// ============================================
// Audit Tables
// ============================================

model AuditLog {
  id              String      @id @default(cuid())
  adminUserId     String
  action          String
  targetType      String
  targetId        String
  changes         Json?
  metadata        Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime    @default(now())

  adminUser       User        @relation("AuditLogs", fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ============================================
// Auth Sessions
// ============================================

model AuthSession {
  id            String   @id @default(cuid())
  userId        String
  refreshToken  String   @unique
  userAgent     String?
  ipAddress     String?
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  revokedAt     DateTime?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}