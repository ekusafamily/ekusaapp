# ==============================================================================
# EKUSA Digital Platform - Environment Variable Example (.env.example)
# Copy this file to .env and fill in your actual production/staging/development values.
# NEVER commit actual credentials or service-role keys to version control.
# ==============================================================================

# --- Application Configuration ---
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://app.ekusa.example.com
ADMIN_URL=https://admin.ekusa.example.com

# --- Supabase Configuration ---
# Your Supabase Project URL (Managed or Self-Hosted)
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase Anon/Publishable Key (Safe for client-side / mobile / web)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Supabase Service Role Key (SERVER-SIDE ONLY - Never expose to client apps)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Database (Supabase PostgreSQL) ---
# Direct connection string for Prisma migrations and backend API
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (non-pooled) for schema migrations
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Authentication (JWT) ---
JWT_SECRET=your-super-secret-jwt-key-minimum-256-bits-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# --- Push Notifications (Firebase Cloud Messaging V1 Standalone) ---
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FCM_PROJECT_ID=your-firebase-project-id

# --- Transactional Email (Resend / SendGrid / SMTP) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your-smtp-api-key
EMAIL_FROM=noreply@ekusa.ac.ke

# --- S3 / Supabase Storage ---
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=ekusa-storage
